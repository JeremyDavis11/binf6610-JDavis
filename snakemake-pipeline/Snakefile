import csv
import os
import re

configfile: "config.yaml"

KNOWN = {"samplesheet", "ref", "region", "outdir", "platform", "executor", "containers"}
unknown = sorted(set(config) - KNOWN)
if unknown:
    raise ValueError(f"unknown config key(s): {', '.join(unknown)}")


PIPELINE = {"name": "variant-call", "version": "1.0.0"}
OUT = config["outdir"]
BIN = os.path.join(workflow.basedir, "bin") # bin/ is not on PATH, call scripts by path
IMAGES = {name: f"docker://{image}" for name, image in config["containers"].items()}

REF = config["ref"] # FASTA
REF_FAI = REF + ".fai"
REF_BWA = [REF + ext for ext in (".amb", ".ann", ".bwt", ".pac", ".sa")]  # bwa's index
REF_DICT = os.path.splitext(REF)[0] + ".dict"

SHEET = config["samplesheet"]
with open(SHEET) as fh:
    ROWS = list(csv.DictReader(fh))
SAMPLES = [row["sample_id"] for row in ROWS]
PAIRED = [row["sample_id"] for row in ROWS if row["library_type"] == "paired"]
SINGLE = [row["sample_id"] for row in ROWS if row["library_type"] == "single"]

def resolve(path):
    return path if os.path.isabs(path) else os.path.join(os.path.dirname(SHEET), path)


READS = {
    row["sample_id"]: [resolve(row["r1_fastq"])]
    + ([resolve(row["r2_fastq"])] if row["library_type"] == "paired" else [])
    for row in ROWS
}


def one_of(names):
    """A wildcard pattern matching exactly
    these sample names, or nothing at all."""
    return "|".join(map(re.escape, names)) \
        if names else "(?!)"


def trimmed(wildcards):
    """The trimmed reads of one sample: one file if single-end, two if paired."""
    s = wildcards.sample
    if s in PAIRED:
        return [f"work/trim/{s}_R1.trim.fastq.gz", f"work/trim/{s}_R2.trim.fastq.gz"]
    return [f"work/trim/{s}_R1.trim.fastq.gz"]

# RULES

rule all:
    input:
        f"{OUT}/cohort.filtered.vcf.gz",
        f"{OUT}/variants.tsv",
        f"{OUT}/multiqc_report.html",
        f"{OUT}/samples.tsv",
        f"{OUT}/manifest.json",

# stage 0 - VALIDATE
rule validate:
    input:
        sheet=SHEET,
        fastqs=[fq for reads in READS.values() for fq in reads],
        ref=REF,
        ref_index=[REF_FAI] + REF_BWA,
        ref_dict=REF_DICT
    output:
        "work/validate/samplesheet.csv",
    log:
        "logs/validate.log",
    container: IMAGES["tools"]
    shell:
        "({BIN}/validate_samplesheet.sh {input.sheet} {input.ref} && cp {input.sheet} {output}) 2> {log}"

# stage 1 - QC_RAW - FastQC on reads as they arrive
rule fast_qc:
    input:
        reads=lambda wc: READS[wc.sample],
        checked=rules.validate.output,
    output:
        directory("work/fastqc/{sample}"),
    threads: 4
    log:
        "logs/fastqc/{sample}.log",
    container: IMAGES["fastqc"]
    shell:
        "(mkdir -p {output} && fastqc -q -t {threads} -o {output} {input.reads}) 2> {log}"


# Stage 2 - trim - 2 rules for paired and single
rule fastp_paired:
    input:
        r1=lambda wc: READS[wc.sample][0],
        r2=lambda wc: READS[wc.sample][1],
        checked=rules.validate.output,
    output:
        r1="work/trim/{sample}_R1.trim.fastq.gz",
        r2="work/trim/{sample}_R2.trim.fastq.gz",
        json="work/trim/{sample}.fastp.json",
        html="work/trim/{sample}.fastp.html",
    wildcard_constraints:
    	sample=one_of(PAIRED),
    threads: 4
    log:
        "logs/fastp/{sample}.log"
    container: IMAGES["fastp"]
    shell:
        "fastp -w {threads} -i {input.r1} -I {input.r2} -o {output.r1} -O {output.r2} "
        "-j {output.json} -h {output.html} 2> {log}"

rule fastp_single:
    input:
        r1=lambda wc: READS[wc.sample][0],
        checked=rules.validate.output,
    output:
        r1="work/trim/{sample}_R1.trim.fastq.gz",
        json="work/trim/{sample}.fastp.json",
        html="work/trim/{sample}.fastp.html",
    wildcard_constraints:
        sample=one_of(SINGLE),
    threads: 4
    log:
        "logs/fastp/{sample}.log",
    container: IMAGES["fastp"]
    shell:
        "fastp -w {threads} -i {input.r1} -o {output.r1} -j {output.json} -h {output.html} 2> {log}"

# Stage 3 - Align - bwa_mem
rule bwa_mem:
    input:
        reads=trimmed,
        ref=REF,
        ref_index=[REF_FAI] + REF_BWA,
    output:
        bam="work/align/{sample}.bam",
    params:
        rg=lambda wc: f"@RG\\tID:{wc.sample}\\tSM:{wc.sample}\\tLB:{wc.sample}\\tPL:ILLUMINA\\tPU:{wc.sample}",
    threads: 8
    log:
        "logs/align/{sample}.bwa_mem.log",
    container: IMAGES["bwa"]
    shell:
         "bwa mem -t {threads} -R '{params.rg}' {input.ref} {input.reads} 2> {log} | samtools view -b -o {output.bam}"

# Stage 4 - postprocess - markduplicates
rule markduplicates:
    input:
        bam="work/align/{sample}.bam",
    output:
        sorted=temp("work/postprocess/{sample}.sorted.bam"),
        markdupbam="work/postprocess/{sample}.markdup.bam",
        bai="work/postprocess/{sample}.markdup.bam.bai",
        flagstat="work/postprocess/{sample}.flagstat.txt",
        metrics="work/postprocess/{sample}.markdup.metrics.txt",
    threads: 8
    log:
        "logs/postprocess/{sample}.log",
    container: IMAGES["gatk"]
    shell:
        """
        samtools sort -@ {threads} -o {output.sorted} {input.bam}
        gatk MarkDuplicates -I {output.sorted} -O {output.markdupbam} -M {output.metrics} > {log} 2>&1
        samtools index -@ {threads} {output.markdupbam}
        samtools flagstat -@ {threads} {output.markdupbam} > {output.flagstat}
        """

# Stage 5 - quantify - haplotypecaller
rule haplotypecaller:
    input:
        bam="work/postprocess/{sample}.markdup.bam",
        bai="work/postprocess/{sample}.markdup.bam.bai",
        fasta=REF,
        fasta_index=[REF_FAI],
        fasta_dict=REF_DICT,
    output:
        vcf="work/quantify/{sample}.g.vcf.gz",
        tbi="work/quantify/{sample}.g.vcf.gz.tbi",
    params:
        region=config["region"],
    threads: 8
    log:
        "logs/quantify/{sample}.log",
    container: IMAGES["gatk"]
    shell:
        "gatk HaplotypeCaller -R {input.fasta} -I {input.bam} -O {output.vcf} -ERC GVCF -L {params.region} --tmp-dir {resources.tmpdir} > {log} 2>&1"


# Stage 6 - merge - joint_genotype
rule joint_genotype:
    input:
        gvcfs=expand("work/quantify/{sample}.g.vcf.gz", sample=SAMPLES),
        tbis=expand("work/quantify/{sample}.g.vcf.gz.tbi", sample=SAMPLES),
        fasta=REF,
        fasta_fai=REF_FAI,
        fasta_dict=REF_DICT,
    output:
        cohort_vcf="work/merge/cohort.vcf.gz",
        cohort_tbi="work/merge/cohort.vcf.gz.tbi",
    params:
        region=config["region"],
        vargs=lambda wc, input: " ".join(f"-V {g}" for g in input.gvcfs),
    threads: 8
    log:
        "logs/merge/genotypegvcfs.log",
    container: IMAGES["gatk"]
    shell:
        """
        rm -rf {resources.tmpdir}/genomicsdb
        gatk GenomicsDBImport {params.vargs} --genomicsdb-workspace-path {resources.tmpdir}/genomicsdb -L {params.region} --tmp-dir {resources.tmpdir} > {log} 2>&1
        gatk GenotypeGVCFs -R {input.fasta} -V gendb://{resources.tmpdir}/genomicsdb -O {output.cohort_vcf} --tmp-dir {resources.tmpdir} >> {log} 2>&1
        """


# Stage 7 - analyze - filter
rule filter:
    input:
        vcf="work/merge/cohort.vcf.gz",
        tbi="work/merge/cohort.vcf.gz.tbi",
        fasta=REF,
        fasta_fai=REF_FAI,
        fasta_dict=REF_DICT,
    output:
        filtered_vcf=f"{OUT}/cohort.filtered.vcf.gz",
        filtered_tbi=f"{OUT}/cohort.filtered.vcf.gz.tbi",
        table=f"{OUT}/variants.tsv",
    threads: 8
    log:
        "logs/analyze/filter.log"
    container: IMAGES["gatk"]
    shell:
        r"""
        gatk VariantFiltration -R {input.fasta} -V {input.vcf} -O {output.filtered_vcf} --filter-name "QD2" --filter-expression "QD < 2.0" > {log} 2>&1
        printf 'chrom\tpos\tref\talt\tqual\tfilter\n' > {output.table}
        bcftools query -f '%CHROM\t%POS\t%REF\t%ALT\t%QUAL\t%FILTER\n' {output.filtered_vcf} >> {output.table}
        """

# Stage 8 - qc_report - multiqc
rule multiqc:
    input:
        qc_files=expand("work/fastqc/{sample}", sample=SAMPLES),
        fastp_files=expand("work/trim/{sample}.fastp.json", sample=SAMPLES),
        metrics=expand("work/postprocess/{sample}.markdup.metrics.txt", sample=SAMPLES),
        flagstat=expand("work/postprocess/{sample}.flagstat.txt", sample=SAMPLES),
    output:
        html=f"{OUT}/multiqc_report.html",
        data=directory(f"{OUT}/multiqc_data"),
    threads: 8
    log:
        "logs/qc_report/multiqc.log",
    container: IMAGES["multiqc"]
    shell:
        """
        multiqc -q -f -o {OUT} {input} > {log} 2>&1
        """


# Stage 9 - publish - publish.smk
PUBLISH_SHEET = rules.validate.output
PUBLISH_RESULTS = [*rules.filter.output, rules.multiqc.output.html]
include: "rules/publish.smk"
