// The pipeline's name and version. A run launched from a repository with -r also gets
// Nextflow's own record of the revision and commit; the manifest copies both.
manifest {
    name            = 'variant-call'
    version         = '1.0.0'
    nextflowVersion = '>=26.04'
}

// What a run needs. Give them on the command line: --samplesheet, --ref, --gtf.
params {
    samplesheet   = null
    ref           = null   // FASTA path     
    outdir        = 'results'
    platform      = 'laptop' 
    region        = 'chr20:1-10000000' 

    // The software: one public image for each kind of step, each pinned to the version
    // of the course conda environment that ran this pipeline in week 2.
    containers = [
        tools        : 'community.wave.seqera.io/library/coreutils_gawk_gzip:7c58ccc2f9ca6bcc',  // stages 0, 6, 9
        fastqc       : 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0',
        fastp        : 'community.wave.seqera.io/library/fastp:1.3.7--075357a9d5c82494',
        bwa          : 'community.wave.seqera.io/library/bwa_samtools:22527ddb3cc80fb3',
        gatk4        : 'community.wave.seqera.io/library/gatk4_samtools_bcftools:1adede7d418fb46b',
        multiqc      : 'quay.io/biocontainers/multiqc:1.35--pyhdfd78af_2'
    ]
}

// The output block in main.nf publishes into outputDir, as copies, not links into work/.
outputDir            = params.outdir
workflow.output.mode = 'copy'

process {
    cpus   = 1
    memory = '2 GB'
    shell  = ['/bin/bash', '-euo', 'pipefail']    // week 1's set -euo pipefail, for every task
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    fields    = 'task_id,name,status,exit,container,native_id,realtime,%cpu,peak_rss'
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/report.html"
}


profiles {
    explorer {
        params.platform = 'singularity-hpc'
        process {
            executor       = 'slurm'
            queue          = 'courses'
            clusterOptions = '--account=binf6610.202710'
            time           = '30m'

            withName: 'ALIGN' {
                cpus   = 8
                memory = '16 GB'
                clusterOptions = '--account=binf6610.202710' //--exclude=c3014
            }
            withName: 'QC_REPORT' {
                memory = '8 GB'
            }
            withName: 'QUANTIFY' {
                cpus = 4
                memory = '16 GB'
                time = '1h'
            }
            withName: 'POSTPROCESS' {
                cpus = 2
                memory = '8 GB'
            }
            withName: 'MERGE' {
                cpus = 2
                memory = '8 GB'
                time = '1h'
                scratch = true
            }
        }
        apptainer {
            enabled    = true
            autoMounts = true
        }
    }
    docker {
        params.platform = 'docker-local'
        docker {
            enabled = true
            runOptions = '--platform linux/amd64'
        }
    }
}
